{
  "manifest_version": 3,
  "name": "UniPass Minimal",
  "description": "用户主动操作后查询 UniPass，并自动填写或手动复制凭据。",
  "version": "5.3.2",
  "key": "",
  "action": {
    "default_title": "UniPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://portal.unipass.top/*",
    "https://jupiter.tec-do.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
