{
  "name": "unipass-extension-minimal",
  "private": true,
  "version": "5.3.3",
  "type": "module",
  "scripts": {
    "audit:static": "node scripts/traffic-light-check.mjs",
    "audit:artifact": "node scripts/release-artifact-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run audit:static && node build.mjs",
    "docs:governance:check": "node scripts/governance-docs-check.mjs",
    "test": "npm run build:wasm && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run docs:governance:check && npm run audit:static && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
