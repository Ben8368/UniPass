{
  "name": "unipass-extension-minimal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:static": "node scripts/traffic-light-check.mjs",
    "build": "node build.mjs",
    "docs:governance:check": "node scripts/governance-docs-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run docs:governance:check && npm run audit:static && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/crypto-js": "^4.2.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
